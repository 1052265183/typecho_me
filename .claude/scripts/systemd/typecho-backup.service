[Unit]
# 正式环境备份（数据库 + uploads），落 F:\1A开发备份\博客备份
#
# 脚本自身带「无变化则跳过」逻辑，所以这里的频率可以定得较高：
# 没变化时它只算一次指纹就退出（秒级、零磁盘写入），有变化才会真正打包。
# 用 timer 每 6 小时检查一次，比每天定点更能及时捕获到改动。
Description=Typecho production backup (change-driven)

[Service]
Type=oneshot
ExecStart=/bin/bash /root/www/typecho_prod/.claude/scripts/_backup_prod.sh
StandardOutput=append:/var/log/typecho-backup.log
StandardError=append:/var/log/typecho-backup.log